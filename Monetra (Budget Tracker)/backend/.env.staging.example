# Monetra backend staging environment.
# Copy this file to `backend/.env` on the Oracle staging VM.
# Do not commit real secrets, Gmail app passwords, or generated keys.

APP_ENV=staging
LOGIN_REQUIRED=true
READ_ONLY_MODE=false
PUBLIC_HEALTHCHECK_ENABLED=true
EXPOSE_ERROR_DETAILS=false

# Generate a new value before staging:
#   powershell -Command "[Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))"
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_HOURS=12

# Docker Compose also sets DATABASE_URL. Keep this aligned with ../.env.
DATABASE_URL=postgresql+psycopg://budget_user:CHANGE_ME_STAGING_DB_PASSWORD@postgres:5432/budget_tracker_staging

GENERATED_REPORTS_DIR=/app/generated_reports
LOG_TIMEZONE=Europe/London
LOG_LEVEL=INFO
LOG_FILE_PATH=/app/.run/monetra.log

# Ollama runs outside the backend container.
# On local Docker Desktop this uses host.docker.internal.
# On an Oracle Linux VM, set this to the VM-accessible Ollama URL after Ollama is installed.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=86400
FASTMCP_PYTHON_EXECUTABLE=python

# RAG / Chroma.
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_PERSIST_DIRECTORY=/app/.run/chroma
RAG_MANIFEST_PATH=/app/.run/rag_manifest.json
RAG_COLLECTION_NAME=monetra_finance_knowledge
RAG_TOP_K=6
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
CHROMA_HTTP_HOST=chroma
CHROMA_HTTP_PORT=8000
CHROMA_HTTP_SSL=false

# Staging email mode.
# hybrid = real SMTP only for allowlisted owned addresses, mock for @monetra.test / @example.test, block all others.
EMAIL_MODE=hybrid
EMAIL_FROM=Rushabh.Dharamshi@gmail.com
EMAIL_ALLOWED_RECIPIENTS=Rushabh.Dharamshi@gmail.com,testpurposes683@gmail.com,rushlovesgames28@gmail.com,rushabh.is.cool28@gmail.com
EMAIL_MOCK_DOMAINS=monetra.test,example.test
MOCK_EMAIL_FROM=demo@monetra.test
REPORT_EMAIL_TO=
REPORT_EMAIL_RECIPIENT_NAME=Rushabh

# Gmail SMTP. Use a Gmail app password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=Rushabh.Dharamshi@gmail.com
SMTP_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD
SMTP_USE_TLS=true
SMTP_REQUIRE_AUTH=true

# Automation scheduler.
AUTOMATION_SCHEDULER_ENABLED=true
AUTOMATION_POLL_SECONDS=900
MONTH_END_EMAIL_HOUR=22
MONTH_END_EMAIL_MINUTE=15

# Optional demo access for portfolio screenshots.
DEMO_ACCESS_ENABLED=false
DEMO_ACCESS_USERNAME=
DEMO_ACCESS_PASSWORD=

