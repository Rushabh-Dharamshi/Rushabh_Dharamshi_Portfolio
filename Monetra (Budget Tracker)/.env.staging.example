# Monetra Docker Compose staging values.
# Copy this file to `.env` on the Oracle staging VM before running docker compose.
# Do not commit the copied `.env` file.

APP_ENV=staging

# PostgreSQL container credentials used by docker-compose.yml.
# Use a new long random password for staging.
POSTGRES_DB=budget_tracker_staging
POSTGRES_USER=budget_user
POSTGRES_PASSWORD=CHANGE_ME_STAGING_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://budget_user:CHANGE_ME_STAGING_DB_PASSWORD@postgres:5432/budget_tracker_staging

# Backend runtime.
LOG_TIMEZONE=Europe/London
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
RAG_EMBEDDING_MODEL=nomic-embed-text
CHROMA_HTTP_PORT=8000

