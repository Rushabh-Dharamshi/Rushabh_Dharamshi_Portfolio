{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:unit && npm run test:bdd",
    "start": "node index.js",
    "test:unit": "jest --runInBand tests/unit tests/routes",
    "test:bdd": "jest --runInBand tests/bdd",
    "test:integration": "jest --runInBand tests/integration",
    "test:all": "npm run test:unit && npm run test:bdd && npm run test:integration",
    "rag:export": "node scripts/exportVertexRagDocuments.js",
    "rag:export:incremental": "node scripts/exportVertexRagDocuments.js --updated-since",
    "rag:vertex:sync": "npm run rag:export && node scripts/uploadAndImportVertexRag.js --wait",
    "rag:vertex:dry-run": "npm run rag:export && node scripts/uploadAndImportVertexRag.js --dry-run",
    "rag:vertex:full-sync": "npm run rag:export && node scripts/uploadAndImportVertexRag.js --wait",
    "rag:vertex:refresh": "npm run rag:export && node scripts/uploadAndImportVertexRag.js --wait",
    "rag:vertex:create-corpus": "python scripts/createVertexRagCorpus.py"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "9.15.1",
    "helmet": "^8.1.0",
    "mysql": "^2.18.1",
    "mysql2": "^3.14.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-cucumber": "^4.5.0",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ]
  }
}
