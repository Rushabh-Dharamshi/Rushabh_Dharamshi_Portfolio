NODE_ENV=production
PORT=5000

# Cloud SQL settings
CLOUD_SQL_CONNECTION_NAME=project-management-tool-488116:europe-west2:project-management-tool-instance
MYSQL_USER=project_management_app_user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=project_management
MYSQL_POOL_SIZE=10

WORKER_POOL_SIZE=4

CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
CHAT_RATE_LIMIT_MAX=40

# Vertex AI RAG + Gemini
AI_PROVIDER=vertex-rag
GCP_PROJECT_ID=project-management-tool-488116
GCP_REGION=europe-west2
VERTEX_RAG_CORPUS_ID=6917529027641081856
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_REGION=global
RAG_TOP_K=4
GEMINI_TEMPERATURE=0.15
GEMINI_MAX_OUTPUT_TOKENS=512


